# Commander Builder — configuration Apache du front statique (déployé dans /www/).
# Généré côté build (public/ → .output/public/) puis uploadé par le workflow.

# --- Force HTTPS + fallback SPA (Nuxt ssr:false) ------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Toute requête HTTP → HTTPS (301).
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Routes client non prérendues → shell SPA (200.html), sans toucher aux
  # fichiers/dossiers réels ni aux assets.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /200.html [L]
</IfModule>

# --- Compression --------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# --- Cache --------------------------------------------------------------------
<IfModule mod_headers.c>
  # Assets versionnés/immuables : cache long.
  <FilesMatch "\.(js|css|woff2?|ttf|otf|png|jpe?g|gif|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML, service worker et manifest : toujours revalider pour que les mises à
  # jour (dont la PWA) se propagent immédiatement. Placé après le bloc ci-dessus
  # pour l'emporter sur sw.js.
  <FilesMatch "(^|/)(sw\.js|workbox-[^/]+\.js|index\.html|200\.html|404\.html|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
